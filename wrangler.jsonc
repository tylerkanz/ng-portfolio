{
  "name": "ng-portfolio",
  "compatibility_date": "2026-08-05",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
